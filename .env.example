# ─────────────────────────────────────────────────────────────
# NexusPay v2.0 Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:5173
NODE_ENV=development

# ── PostgreSQL (primary database — Phase 2+) ──────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=nexuspay_app
PG_PASSWORD=nexuspay_dev_password
PG_NAME=nexuspay
PG_POOL_MAX=10
# Set to "true" to enable TLS (requires PG_SSL_CA path)
PG_SSL=false
# PG_SSL_CA=/path/to/pg-ca.pem

# ── MySQL (legacy — kept during PostgreSQL migration) ──────────
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3307
DB_MYSQL_USER=nexuspay_app
DB_MYSQL_PASSWORD=nexuspay_dev_password
DB_MYSQL_NAME=nexuspay
DB_MYSQL_POOL_MAX=10
DB_MYSQL_SSL=false

# ── MongoDB ────────────────────────────────────────────────────
DB_MONGO_URI=mongodb://localhost:27017/nexuspay
DB_MONGO_TLS=false

# ── Authentication & Tokens ────────────────────────────────────
# JWT_SECRET: legacy fallback (also used if ACCESS/REFRESH not set)
JWT_SECRET=replace_with_at_least_32_random_characters_here_minimum

# Short-lived access token secret (recommended: separate from refresh)
ACCESS_TOKEN_SECRET=replace_with_access_token_secret_min_32_chars_here

# Long-lived refresh token secret (stored only as hash in DB)
REFRESH_TOKEN_SECRET=replace_with_refresh_token_secret_min_32_chars_here

# Cookie signing secret (for refresh token HttpOnly cookie)
COOKIE_SECRET=replace_with_cookie_secret_min_32_chars_here_please

# Token lifetimes
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── MFA / Transaction OTP ──────────────────────────────────────
# Set to "false" to disable MFA (not recommended for production)
MFA_ENABLED=true

# Transfers above this amount (in account currency) require OTP confirmation
TRANSFER_MFA_THRESHOLD=1000

# ── Email (SMTP) ───────────────────────────────────────────────
# Set EMAIL_DEV_PREVIEW=true to log emails/OTPs to console instead of sending
EMAIL_DEV_PREVIEW=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM=NexusPay <no-reply@nexuspay.com>

# ── Audit log retention ────────────────────────────────────────
# Optional: set to keep MongoDB activity logs for N days (omit = keep forever)
# AUDIT_LOG_RETENTION_DAYS=365
